# 复制本文件为 .env.local 后填入真实值。.env.local 不会被提交。

# ────── 数据源模式 ──────
# mock = 走兜底 JSON;live = 走智慧芽真 API
DATA_MODE=mock

# ────── 智慧芽开放平台 ──────
PATSNAP_API_KEY=
PATSNAP_API_BASE=https://connect.zhihuiya.com

# ────── LLM:主推理 (DeepSeek) ──────
LLM_CHAT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-pro

# ────── LLM:模态桥接 (Qwen-VL via DashScope) ──────
LLM_VISION_PROVIDER=qwen-vl
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen-vl-max
